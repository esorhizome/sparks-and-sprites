; Sparks & Sprites — Godot demos
; Open this file with Godot 4.7+ (Import button on the project manager), press F5.
; Every demo scene builds itself from code in _ready(), so each script IS the demo.
;
; (Heads-up: the Godot editor rewrites this file and drops these comments
;  whenever it saves settings — README.md in this folder is the durable home.)
;
; Capability note: every web-gallery demo has a full Godot twin here, including
; all 104 elemental buttons (scenes/elements/), all 104 cube-codex character
; effects (scenes/cubefx/), and all 104 glyph-grimoire text effects
; (scenes/textfx/). Where the web canvas and Godot spell an effect
; differently (gradients, additive blending, clipping, trails, font weights),
; the scripts note the translation in place; none of it is beyond _draw() + math.
;
; Rhymes: every one of the 312 effects also has a RHYME — the same effect with
; two or three dials turned (scenes/elements/*_r.gd, scenes/cubefx/*_r.gd,
; scenes/textfx/*_r.gd).
; RIGHT-CLICK any card in the bestiary or the codex to swap original ⇄ rhyme.
; Each *_r.gd preloads its original as Base and overrides only the branches
; whose dials moved; diffing the two files is the whole lesson.

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sparks & Sprites — Godot demos"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
