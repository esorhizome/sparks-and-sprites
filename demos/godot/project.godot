; Sparks & Sprites — Godot demos
; Open this file with Godot 4.7+ (Import button on the project manager), press F5.
; Every demo scene builds itself from code in _ready(), so each script IS the demo.
;
; Capability note: every one of the web gallery's demos has a full Godot twin
; here — including all 104 elemental buttons (scenes/elements/, paged by family
; in the elemental_buttons scene). Where the web canvas and Godot spell an
; effect differently (gradients, additive blending, clipping, trails), the
; scripts note the translation in place; none of it is beyond _draw() + math.
; See README.md in this folder for the details and the headless health checks.

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sparks & Sprites — Godot demos"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
